<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Accueil -->
    <string name="hero_description">一个以YouTube音乐为歌源的开源多语言安卓音乐播放器</string>
    <!-- Navigation -->
    <string name="navigation_glass_label">玻璃板</string>
    <!-- Fonctionnalités -->
    <string name="feature_artists_description">用顶部歌曲、专辑和类似的艺术家来探索全面的艺术家简介。</string>
    <string name="feature_artists_title">详细的艺人配置文件。</string>
    <string name="feature_audio_controls_description">自定义您使用高级音频控制、备份/恢复功能的体验等等。</string>
    <string name="feature_audio_controls_title">高级音频控件。</string>
    <string name="feature_carousel_description">享受一个独特的、令人惊叹的 3D 旋转屏幕来播放音乐。</string>
    <string name="feature_carousel_title">旋转播放器视图。</string>
    <string name="feature_compatibility_description">随时随地畅享音乐！N-Zik 支持 Android Mobile、Android Tablet、Android Auto、Android Automotive 和 Android TV。（之后将支持 Wear OS）</string>
    <string name="feature_compatibility_title">多设备兼容性。</string>
    <string name="feature_discord_description">直接在您的 Discord 个人资料上显示您正在播放的曲目，从而显示您当前的乐曲。</string>
    <string name="feature_discord_title">Discord Rich Presence。</string>
    <string name="feature_glass_credits">Android 应用程序玻璃积分：</string>
    <string name="feature_glass_description">玻璃在新的安装上处于关闭状态。在设置中，按类别选择原生、等距或玻璃表示并调整渲染质量。 玻璃可能会增加渲染工作和电池使用；降低其质量或禁用它来适应您的设备。</string>
    <string name="feature_glass_title">可选玻璃效果 (BETA)。</string>
    <string name="feature_history_description">永远不要丢失你喜欢的一首歌。随时访问你完整的听觉历史。</string>
    <string name="feature_history_title">完整历史记录。</string>
    <string name="feature_lyrics_description">获取，显示，编辑，实时翻译歌词，按字逐字同步准确。</string>
    <string name="feature_lyrics_title">高级歌词支持。</string>
    <string name="feature_modern_ui_description">一个可自定义的接口，与无缝导航，YouTube集成和一个可选的玻璃玩家。</string>
    <string name="feature_modern_ui_title">现代 &amp; 直观界面。</string>
    <string name="feature_offline_caching_description">自动缓存可自定义限制离线播放的歌曲，或下载可永久存取的曲目。</string>
    <string name="feature_offline_caching_title">智能离线缓存。</string>
    <string name="feature_playlists_description">在一个统一的接口中轻松创建、导入、导出和管理您的播放列表。</string>
    <string name="feature_playlists_title">播放列表管理。</string>
    <string name="feature_profiles_description">关联账号并自定义应用：与 YouTube Music 同步，启用 Discord Rich Presence 和 Last.fm 打点，并在应用内多个配置文件之间切换——每个配置文件都有独立的名称、头像、数据库和设置。</string>
    <string name="feature_profiles_title">多个配置文件</string>
    <string name="feature_queue_description">跟踪下一步播放的内容，重新排列歌曲，并管理您即将播放的歌曲。</string>
    <string name="feature_queue_title">播放队列。</string>
    <string name="feature_rewind_description">用个性化的回顾重温你的听歌历程。每年、每月，全部属于你。</string>
    <string name="feature_rewind_title">N-Zik Rewind</string>
    <string name="feature_search_description">轻松找到您最喜欢的歌曲、专辑和艺术家，即使是用您的声音。</string>
    <string name="feature_search_title">搜索 &amp; 语音搜索。</string>
    <string name="feature_theme_presets_description">从6个美丽的视觉主题中选择个性化您的音乐体验。</string>
    <string name="feature_theme_presets_title">主题预设。</string>
    <string name="feature_updates_description">直接从 GitHub 接收应用内自动更新，无需手动下载新的 APK。</string>
    <string name="feature_updates_title">OTA更新日期。</string>
    <string name="feature_visualizer_description">享受实时视觉效果与您的音乐完全同步。</string>
    <string name="feature_visualizer_title">沉浸式音频可视化器。</string>
    <!-- Téléchargement -->
